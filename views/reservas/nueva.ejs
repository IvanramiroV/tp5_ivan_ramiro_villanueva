<section>
    <h3>Formulario de Solicitud de Sala</h3>
    <% if (locals.error) { %>
        <div role="alert" class="alerta-error">
            ⚠️ <%= error %>
        </div>
    <% } %>
    <form action="/reservas" method="POST">
        <div>
            <label for="estudiante">Nombre y Apellido:</label>
            <input type="text" id="estudiante" name="estudiante" value="<%= locals.valores ? valores.estudiante : '' %>" required>
        </div>
        <div>
            <label for="email">Correo Electrónico:</label>
            <input type="email" id="email" name="email" value="<%= locals.valores ? valores.email : '' %>" required>
        </div>
        <div>
            <label for="sala">Sala Asignada:</label>
            <select id="sala" name="sala" required>
                <option value="">-- Seleccione una sala --</option>
                <option value="Sala Norte" <%= locals.valores && valores.sala === 'Sala Norte' ? 'selected' : '' %>>Sala Norte</option>
                <option value="Sala Sur" <%= locals.valores && valores.sala === 'Sala Sur' ? 'selected' : '' %>>Sala Sur</option>
                <option value="Sala Multimedia" <%= locals.valores && valores.sala === 'Sala Multimedia' ? 'selected' : '' %>>Sala Multimedia</option>
            </select>
        </div>
        <div>
            <label for="fecha">Fecha:</label>
            <input type="date" id="fecha" name="fecha" value="<%= locals.valores ? valores.fecha : '' %>" required>
        </div>
        <div>
            <label for="turno">Turno:</label>
            <select id="turno" name="turno" required>
                <option value="">-- Seleccione un turno --</option>
                <option value="Mañana" <%= locals.valores && valores.turno === 'Mañana' ? 'selected' : '' %>>Mañana</option>
                <option value="Tarde" <%= locals.valores && valores.turno === 'Tarde' ? 'selected' : '' %>>Tarde</option>
                <option value="Noche" <%= locals.valores && valores.turno === 'Noche' ? 'selected' : '' %>>Noche</option>
            </select>
        </div>
        <div>
            <label for="personas">Cantidad de Personas (1 a 6):</label>
            <input type="number" id="personas" name="personas" min="1" max="6" value="<%= locals.valores ? valores.personas : '' %>" required>
        </div>
        <button type="submit">Enviar Solicitud</button>
    </form>
</section>